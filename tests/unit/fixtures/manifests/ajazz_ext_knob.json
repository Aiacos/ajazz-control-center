      "States": [
        {
          "Image": "icons/state.png",
          "FSize": "12",
          "FFamily": "Courier New",
          "FontStyle": "Regular",
          "TitleColor": "#00FF00",
          "TitleAlignment": "top"
        }
      ]
    }

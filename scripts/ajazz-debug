#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Out-of-process control client for AJAZZ Control Center.

Talks the newline-delimited JSON-RPC protocol of the in-app debug control
channel (see src/app/src/debug_control_server.hpp) over its Unix domain
socket. The channel is opt-in: launch the app with AJAZZ_DEBUG_CONTROL=1
first, then drive it from here.

Examples:
    ajazz-debug ping
    ajazz-debug methods
    ajazz-debug state
    ajazz-debug log.tail --params '{"level": "debug", "limit": 50}'
    ajazz-debug log.setLevel --params '{"level": "trace"}'
    ajazz-debug device.list
    ajazz-debug --watch log.tail --params '{"level": "info"}'

Exit status is 0 on an {ok: true} reply, 1 on a transport error, 2 on an
{ok: false} reply from the server.
"""

from __future__ import annotations

import argparse
import json
import os
import socket
import sys
import time
from pathlib import Path

DEFAULT_SOCKET_NAME = "ajazz-control-center-debug.sock"


def default_socket_path() -> str:
    """Mirror DebugControlServer::defaultSocketPath() resolution.

    An absolute path in AJAZZ_DEBUG_CONTROL wins; otherwise the socket lives
    under XDG_RUNTIME_DIR, falling back to the system temp dir.
    """
    env = os.environ.get("AJAZZ_DEBUG_CONTROL", "")
    if "/" in env:
        return env
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"  # noqa: S108 - matches Qt fallback
    return str(Path(runtime) / DEFAULT_SOCKET_NAME)


def send_request(sock_path: str, method: str, params: dict, timeout: float) -> dict:
    """Send one request and return the decoded response object."""
    request = json.dumps({"id": 1, "method": method, "params": params})
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(timeout)
        sock.connect(sock_path)
        sock.sendall(request.encode("utf-8") + b"\n")

        buffer = b""
        while b"\n" not in buffer:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buffer += chunk

    line = buffer.split(b"\n", 1)[0]
    return json.loads(line.decode("utf-8"))


def parse_args(argv: list[str]) -> argparse.Namespace:
    """Parse the command-line arguments."""
    parser = argparse.ArgumentParser(
        prog="ajazz-debug",
        description="Drive a running AJAZZ Control Center via its debug control socket.",
    )
    parser.add_argument("method", help="RPC method name, e.g. ping / state / log.tail")
    parser.add_argument(
        "--params",
        default="{}",
        help="JSON object of method parameters (default: {}).",
    )
    parser.add_argument(
        "--socket",
        default=None,
        help=f"Override the socket path (default: $XDG_RUNTIME_DIR/{DEFAULT_SOCKET_NAME}).",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=5.0,
        help="Per-request socket timeout in seconds (default: 5).",
    )
    parser.add_argument(
        "--watch",
        type=float,
        nargs="?",
        const=1.0,
        default=None,
        metavar="SECONDS",
        help="Re-issue the request every SECONDS (default 1) until interrupted.",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="Print the full response object rather than just result.",
    )
    return parser.parse_args(argv)


def render(response: dict, *, raw: bool) -> None:
    """Print the result (or the whole response on error / --raw)."""
    if raw or not response.get("ok", False):
        print(json.dumps(response, indent=2))
        return
    print(json.dumps(response.get("result", {}), indent=2))


def main(argv: list[str]) -> int:
    """Entry point: parse args, issue the request(s), return an exit code."""
    args = parse_args(argv)
    sock_path = args.socket or default_socket_path()

    try:
        params = json.loads(args.params)
    except json.JSONDecodeError as exc:
        print(f"--params is not valid JSON: {exc}", file=sys.stderr)
        return 1
    if not isinstance(params, dict):
        print("--params must be a JSON object", file=sys.stderr)
        return 1

    def one_shot() -> int:
        try:
            response = send_request(sock_path, args.method, params, args.timeout)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"request failed ({sock_path}): {exc}", file=sys.stderr)
            return 1
        render(response, raw=args.raw)
        return 0 if response.get("ok", False) else 2

    if args.watch is None:
        return one_shot()

    try:
        while True:
            one_shot()
            time.sleep(args.watch)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
